{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "OneUI",
  "version": "1.0.0",
  "description": "框架无关设计 Token 导出。三层结构 primitive / semantic / component，供设计工具、跨端（小程序、React Native、Android、iOS）对齐使用。CSS 实现见 tokens.css。",
  "primitive": {
    "neutral": {
      "0": {
        "type": "color",
        "value": "#FFFFFF"
      },
      "25": {
        "type": "color",
        "value": "#FCFCFD"
      },
      "50": {
        "type": "color",
        "value": "#F7F7F8"
      },
      "100": {
        "type": "color",
        "value": "#F1F1F3"
      },
      "150": {
        "type": "color",
        "value": "#E7E7EA"
      },
      "200": {
        "type": "color",
        "value": "#D9D9DE"
      },
      "300": {
        "type": "color",
        "value": "#C1C1C8"
      },
      "400": {
        "type": "color",
        "value": "#9C9CA5"
      },
      "500": {
        "type": "color",
        "value": "#71717A"
      },
      "600": {
        "type": "color",
        "value": "#52525B"
      },
      "700": {
        "type": "color",
        "value": "#3F3F46"
      },
      "800": {
        "type": "color",
        "value": "#27272A"
      },
      "900": {
        "type": "color",
        "value": "#18181B"
      },
      "950": {
        "type": "color",
        "value": "#0E0E11"
      }
    },
    "primary": {
      "note": "默认等于中性墨黑，替换为任意品牌色即可全局换肤。档位约定：400=active、500=hover、600=主色、700=更深一档备选",
      "50": {
        "type": "color",
        "value": "{neutral.50}"
      },
      "100": {
        "type": "color",
        "value": "{neutral.150}"
      },
      "200": {
        "type": "color",
        "value": "{neutral.200}"
      },
      "300": {
        "type": "color",
        "value": "{neutral.300}"
      },
      "400": {
        "type": "color",
        "value": "{neutral.600}"
      },
      "500": {
        "type": "color",
        "value": "{neutral.700}"
      },
      "600": {
        "type": "color",
        "value": "{neutral.900}"
      },
      "700": {
        "type": "color",
        "value": "{neutral.950}"
      }
    },
    "success": {
      "50": {
        "type": "color",
        "value": "#F0FDF4"
      },
      "500": {
        "type": "color",
        "value": "#16A34A"
      },
      "700": {
        "type": "color",
        "value": "#15803D"
      }
    },
    "warning": {
      "50": {
        "type": "color",
        "value": "#FFFBEB"
      },
      "500": {
        "type": "color",
        "value": "#D97706"
      },
      "700": {
        "type": "color",
        "value": "#B45309"
      }
    },
    "danger": {
      "50": {
        "type": "color",
        "value": "#FEF2F2"
      },
      "500": {
        "type": "color",
        "value": "#DC2626"
      },
      "700": {
        "type": "color",
        "value": "#B91C1C"
      }
    },
    "info": {
      "50": {
        "type": "color",
        "value": "#F0F9FF"
      },
      "500": {
        "type": "color",
        "value": "#0284C7"
      },
      "700": {
        "type": "color",
        "value": "#0369A1"
      }
    }
  },
  "semantic": {
    "surface": {
      "bg": {
        "type": "color",
        "value": "{neutral.50}"
      },
      "default": {
        "type": "color",
        "value": "{neutral.0}"
      },
      "subtle": {
        "type": "color",
        "value": "{neutral.25}"
      },
      "muted": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "invert": {
        "type": "color",
        "value": "{neutral.900}"
      }
    },
    "text": {
      "primary": {
        "type": "color",
        "value": "{neutral.900}"
      },
      "secondary": {
        "type": "color",
        "value": "{neutral.600}"
      },
      "tertiary": {
        "type": "color",
        "value": "{neutral.500}"
      },
      "disabled": {
        "type": "color",
        "value": "{neutral.400}"
      },
      "invert": {
        "type": "color",
        "value": "{neutral.0}"
      }
    },
    "border": {
      "weak": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "default": {
        "type": "color",
        "value": "{neutral.150}"
      },
      "strong": {
        "type": "color",
        "value": "{neutral.200}"
      }
    },
    "primary": {
      "default": {
        "type": "color",
        "value": "{primary.600}"
      },
      "hover": {
        "type": "color",
        "value": "{primary.500}"
      },
      "active": {
        "type": "color",
        "value": "{primary.400}"
      },
      "weak": {
        "type": "color",
        "value": "{primary.50}"
      },
      "weakHover": {
        "type": "color",
        "value": "{primary.100}"
      },
      "border": {
        "type": "color",
        "value": "{primary.200}"
      },
      "onPrimary": {
        "type": "color",
        "value": "{neutral.0}"
      }
    },
    "control": {
      "note": "灰面槽位：深色模式必须翻转，否则会漏出亮块",
      "track": {
        "type": "color",
        "value": "{neutral.500}",
        "note": "轨道/中性标记。不能取 neutral.300：白底仅 1.79:1，未选中开关的轨道与页面融成一片，白旋钮也看不出位置"
      },
      "active": {
        "type": "color",
        "value": "{neutral.400}",
        "note": "悬停/按压：比常态亮一档"
      },
      "disabledBg": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "skeleton": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "skeletonAlt": {
        "type": "color",
        "value": "{neutral.150}"
      },
      "knob": {
        "type": "color",
        "value": "{neutral.0}",
        "note": "开关旋钮/勾选框勾。白件在深色模式也不翻转，只有 track 跟着主题变"
      }
    },
    "invert": {
      "note": "反白区块内部：底反白后前景/描边/实心按钮都要跟着反白",
      "surface": {
        "type": "color",
        "value": "{neutral.900}"
      },
      "on": {
        "type": "color",
        "value": "{neutral.0}"
      },
      "onWeak": {
        "type": "color",
        "value": "{neutral.300}"
      },
      "onBorder": {
        "type": "color",
        "value": "{neutral.600}"
      },
      "action": {
        "type": "color",
        "value": "{neutral.900}"
      }
    },
    "code": {
      "bg": {
        "type": "color",
        "value": "{neutral.950}"
      },
      "text": {
        "type": "color",
        "value": "{neutral.100}"
      }
    },
    "tooltip": {
      "bg": {
        "type": "color",
        "value": "{neutral.900}"
      },
      "text": {
        "type": "color",
        "value": "{neutral.0}"
      }
    },
    "onStatus": {
      "note": "状态实心底上的前景（危险实心按钮、状态徽标）。#FFF 在 danger.500 上 4.83:1，两主题通用",
      "type": "color",
      "value": "{neutral.0}"
    },
    "selection": {
      "note": "文案选择高亮。深色模式必须反转为浅底深字（neutral.50 / neutral.900）",
      "bg": {
        "type": "color",
        "value": "{neutral.900}"
      },
      "text": {
        "type": "color",
        "value": "{neutral.0}"
      }
    },
    "link": {
      "note": "链接下划线。不能取 neutral.300：白底仅 2.05:1，而下划线是唯一的链接信号，须 >=3:1",
      "underline": {
        "type": "color",
        "value": "{text.tertiary}"
      }
    },
    "separator": {
      "note": "弱分隔符（面包屑、时间线圆点描边），只作装饰。深色模式覆盖为 neutral.500",
      "type": "color",
      "value": "{neutral.300}"
    },
    "toastIcon": {
      "note": "Toast 图标。Toast 底深色模式反白，图标必须换档，否则亮图标压亮底（#4ADE80 on #FFF 仅 1.74:1）",
      "success": {
        "type": "color",
        "value": "#4ADE80",
        "note": "深色模式改用 {success.700}"
      },
      "danger": {
        "type": "color",
        "value": "#F87171",
        "note": "深色模式改用 {danger.700}"
      },
      "warning": {
        "type": "color",
        "value": "#FBBF24",
        "note": "深色模式改用 {warning.700}"
      }
    },
    "marker": {
      "note": "承载信息的图形标记描边（时间线圆点、步骤点），须 >=3:1。与 separator 不同：后者是纯装饰，属 WCAG 1.4.11 例外",
      "type": "color",
      "value": "{text.tertiary}"
    }
  },
  "component": {
    "button": {
      "height": {
        "sm": {
          "type": "dimension",
          "value": "32px"
        },
        "md": {
          "type": "dimension",
          "value": "40px"
        },
        "lg": {
          "type": "dimension",
          "value": "48px"
        }
      },
      "radius": {
        "type": "dimension",
        "value": "{radius.control}"
      },
      "primaryBg": {
        "type": "color",
        "value": "{primary.600}"
      },
      "primaryBgHover": {
        "type": "color",
        "value": "{primary.500}"
      },
      "primaryBgActive": {
        "type": "color",
        "value": "{primary.400}"
      },
      "primaryText": {
        "type": "color",
        "value": "{neutral.0}"
      },
      "disabledBg": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "disabledText": {
        "type": "color",
        "value": "{neutral.400}"
      }
    },
    "input": {
      "height": {
        "sm": {
          "type": "dimension",
          "value": "32px"
        },
        "md": {
          "type": "dimension",
          "value": "40px"
        },
        "lg": {
          "type": "dimension",
          "value": "48px"
        }
      },
      "border": {
        "type": "color",
        "value": "{neutral.200}"
      },
      "placeholder": {
        "type": "color",
        "value": "{neutral.400}"
      }
    },
    "card": {
      "radius": {
        "type": "dimension",
        "value": "{radius.card}"
      },
      "padding": {
        "type": "dimension",
        "value": "24px"
      },
      "border": {
        "type": "color",
        "value": "{neutral.150}"
      }
    },
    "sidenav": {
      "note": "选中底不复用 primaryWeak：中性主题下 primaryWeak 等于页面底 bg，选中态会彻底看不见",
      "itemHeight": {
        "type": "dimension",
        "value": "32px"
      },
      "itemRadius": {
        "type": "dimension",
        "value": "{radius.control}"
      },
      "itemText": {
        "type": "color",
        "value": "{text.secondary}"
      },
      "itemTextActive": {
        "type": "color",
        "value": "{text.primary}"
      },
      "labelText": {
        "type": "color",
        "value": "{text.tertiary}"
      },
      "bgHover": {
        "type": "color",
        "value": "{neutral.100}"
      },
      "bgActive": {
        "type": "color",
        "value": "{neutral.150}"
      },
      "barActive": {
        "type": "color",
        "value": "{primary.600}"
      },
      "barWidth": {
        "type": "dimension",
        "value": "2px"
      },
      "barHeight": {
        "type": "dimension",
        "value": "16px"
      }
    }
  },
  "scale": {
    "fontSize": {
      "40": "40px",
      "32": "32px",
      "24": "24px",
      "20": "20px",
      "16": "16px",
      "15": "15px",
      "14": "14px",
      "13": "13px",
      "12": "12px",
      "11": "11px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px",
      "pill": "999px"
    },
    "shadow": {
      "xs": "0 1px 2px rgba(16,18,22,.05)",
      "sm": "0 1px 3px rgba(16,18,22,.08), 0 1px 2px rgba(16,18,22,.04)",
      "md": "0 4px 12px rgba(16,18,22,.08)",
      "lg": "0 12px 32px rgba(16,18,22,.12)",
      "xl": "0 24px 56px rgba(16,18,22,.18)"
    },
    "motion": {
      "fast": "100ms",
      "normal": "180ms",
      "slow": "280ms",
      "loop": "1200ms"
    },
    "zIndex": {
      "sticky": 20,
      "dropdown": 60,
      "overlay": 80,
      "modal": 90,
      "toast": 110,
      "tooltip": 120
    },
    "breakpoint": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "hitMinimum": "44px"
  }
}
